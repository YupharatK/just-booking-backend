PORT=3000

# Aiven MySQL
DB_HOST=your-aiven-host.aivencloud.com
DB_PORT=3306
DB_USER=avnadmin
DB_PASSWORD=your-password
DB_NAME=just_booking
DB_SSL=true
# Optional if Aiven requires an explicit CA certificate.
# DB_SSL_CA_PATH=/absolute/path/to/ca.pem
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# DB_SSL_REJECT_UNAUTHORIZED=true

# Change this before real use.
JWT_SECRET=replace-with-a-long-random-secret

# Optional: used to return a QR URL placeholder for each booking.
PAYMENT_QR_BASE_URL=https://payment.example.com/qr

# Cloudinary image storage
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
MAX_IMAGE_SIZE_MB=5

# Optional: auto-create/update the first admin account when the server starts.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password
ADMIN_FIRST_NAME=Just
ADMIN_LAST_NAME=Booking
